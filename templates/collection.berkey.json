      "blocks": {
        "column_f9i837": {
          "type": "column",
          "settings": {
            "title": "<strong>No Electricity Required</strong>",
            "text": "<p>Berkey® systems use gravity to filter water, so they operate without electricity, plumbing, or water pressure. Simply fill the upper chamber and dispense filtered water from the lower chamber.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_Xa9XPY": {
          "type": "column",
          "settings": {
            "title": "Practical for Everyday Use",
            "text": "<p>A Berkey® system can serve as a daily household drinking-water solution on the countertop, making filtered water readily available for drinking, cooking, coffee, tea, and other everyday needs.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_6zRew4": {
          "type": "column",
          "settings": {
            "title": "Durable Stainless-Steel Construction",
            "text": "<p>Berkey® stainless-steel systems are built with highly polished AISI 304 stainless-steel housings for durable, long-term household use.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_tNG3Mi": {
          "type": "column",
          "settings": {
            "title": "Cleanable, Replaceable Filters",
            "text": "<p>Black Berkey® Elements can be cleaned during their service life and replaced when needed. Berkey recommends replacement at about 3,000 gallons per element, or 6,000 gallons per set of two, depending on source-water quality.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
